# 이 파일을 복사해 .env 로 만들고 값을 채우세요:  cp .env.example .env

# MongoDB Atlas 연결 문자열 — todo 프로젝트와 같은 클러스터, DB 이름만 mini-diary로 다르게
# 형식: mongodb+srv://<사용자>:<비밀번호>@<클러스터>/mini-diary?retryWrites=true&w=majority&appName=<앱이름>
DATABASE_URL=""

# Auth.js 세션 서명 키 — 생성: pnpm dlx auth secret  (todo 프로젝트와 공유하지 말고 새로 생성)
AUTH_SECRET=""

# 배포 시 프로덕션 URL (예: https://your-app.vercel.app)
# Vercel 에서는 자동 감지되므로 보통 생략 가능. 로컬은 불필요.
# AUTH_URL=""
